module(
    name = "rules_wine",
    version = "0.0.0",
)

bazel_dep(name = "platforms", version = "1.0.0")
bazel_dep(name = "rules_shell", version = "0.8.0")

http_archive = use_repo_rule("@bazel_tools//tools/build_defs/repo:http.bzl", "http_archive")

# New-style WoW64 build: 64-bit prefix, no i386 host libraries required.
http_archive(
    name = "wine_linux_x86_64",
    build_file = "//wine/private:prebuilt.BUILD.bazel",
    sha256 = "39574efa1132c3ca0d5c77dd2eddbe4a49cca0d6cc2c290ff4924493a1c40314",
    strip_prefix = "wine-11.0-amd64-wow64",
    urls = ["https://github.com/Kron4ek/Wine-Builds/releases/download/11.0/wine-11.0-amd64-wow64.tar.xz"],
)

deb_archive = use_repo_rule("//wine/private:deb_archive.bzl", "deb_archive")

# Needs glibc 2.39+ and a 4K-page kernel. The pool URL disappears once sid moves
# on; the snapshot URL is permanent.
deb_archive(
    name = "box64_linux_aarch64",
    build_file = "//wine/private:box64.BUILD.bazel",
    sha256 = "136cf47a54345d180cdcdb61ac320717d50047d6c0d13ca5e3f6335cd7e1bdbf",
    urls = [
        "https://deb.debian.org/debian/pool/main/b/box64/box64_0.4.3-3+dfsg-1_arm64.deb",
        "https://snapshot.debian.org/archive/debian/20260613T203105Z/pool/main/b/box64/box64_0.4.3-3%2Bdfsg-1_arm64.deb",
    ],
)
